<div class="mt-4">
    <h3>Cập nhật bài viết</h3>
    <form method="POST" action="/blogs/{{blog._id}}?_method=PUT">
        <div class="form-group">
            <label for="name">Tiêu đề bài viết</label>
            <input type="text" class="form-control" value="{{blog.name}}" id="name" name="name" required>
        </div>
        <div class="form-group">
            <label for="description">Mô tả ngắn</label>
            <textarea class="form-control" id="description" name="description">{{blog.description}}</textarea>
        </div>
        <div class="form-group">
            <label for="image">Link hình ảnh</label>
            <input type="text" class="form-control" value="{{blog.image}}" id="image" name="image" maxlength="5242880" placeholder="URL https://... hoặc data:image/...;base64,...">
        </div>
        <button type="submit" class="btn btn-primary mt-2">Lưu lại</button>
    </form>
</div>